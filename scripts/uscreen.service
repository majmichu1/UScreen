[Unit]
Description=UScreen - USB Second Display Server
Documentation=https://github.com/uscreen/uscreen
After=network.target graphical-session.target

[Service]
Type=simple
# No --edid here on purpose: passing one pins the virtual display to a single
# baked-in resolution and disables auto-resolution, so the display would stop
# following the tablet. Without it the daemon generates an EDID at runtime for
# whatever resolution is configured or reported.
ExecStart=%h/.local/bin/uscreen --helper %h/.local/bin/evdi_helper start
ExecStop=%h/.local/bin/uscreen stop
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
